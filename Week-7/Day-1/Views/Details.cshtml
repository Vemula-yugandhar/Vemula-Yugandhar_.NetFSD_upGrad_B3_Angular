@model ContactInfo


<h1>Contact Details:</h1>
<p><b>ContactID:</b> @Model.ContactId</p>
<p><b>First Name:</b> @Model.FirstName</p>
<p><b>Last Name</b> @Model.LastName</p>
<p><b>Company Name</b> @Model.CompanyName</p>
<p><b>Email ID:</b> @Model.EmailId</p>
<p><b>Phone Number</b> @Model.PhoneNumber</p>
<p><b>Designation</b> @Model.Designation</p>
</br >
</br>
<a class="btn btn-secondary" asp-action="Contacts">Back To List</a>
